# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Reddit OAuth credentials (required for --source reddit)
# Apply at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# Reddit User-Agent — Reddit requires this exact format:
# <platform>:<app_id>:<version> (by /u/<your_reddit_username>)
REDDIT_USER_AGENT=python:uyam-collector:v0.1.0 (by /u/your_reddit_username)

# HMAC key for author pseudonymization.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this consistent across all collection runs so author hashes match.
# Changing this key makes all previously stored hashes irreconcilable.
AUTHOR_HMAC_KEY=your_hmac_key_here
